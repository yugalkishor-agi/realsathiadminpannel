<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/auth_login_background">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollContent"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:overScrollMode="never"
        app:layout_constraintBottom_toTopOf="@id/bottomContent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:id="@+id/contentContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="120dp"
            android:paddingEnd="20dp"
            android:paddingBottom="24dp">

            <TextView
                android:id="@+id/textTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="@string/otp_title"
                android:textColor="@color/auth_text_primary"
                android:textSize="25sp"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/rowOtpDestination"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/textOtpPrefix"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/otp_sent_prefix"
                    android:textColor="@color/auth_text_hint"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/textOtpPhone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:textColor="@color/auth_text_primary"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    tools:text="9876543210" />

                <ImageView
                    android:id="@+id/imageEditPhone"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_marginStart="8dp"
                    android:contentDescription="@string/content_desc_edit_number"
                    android:src="@drawable/ic_edit_16"
                    android:tint="@color/auth_text_primary" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/otpBoxesContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:gravity="center"
                android:orientation="horizontal">

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardOtp1"
                    android:layout_width="0dp"
                    android:layout_height="50dp"
                    android:layout_weight="1"
                    app:cardBackgroundColor="@color/auth_surface"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="0dp"
                    app:strokeColor="@color/auth_surface_stroke"
                    app:strokeWidth="1dp">

                    <TextView
                        android:id="@+id/textOtpDigit1"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:textColor="@color/auth_text_primary"
                        android:textSize="23sp"
                        android:textStyle="bold"
                        tools:text="1" />
                </com.google.android.material.card.MaterialCardView>

                <Space
                    android:layout_width="8dp"
                    android:layout_height="1dp" />

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardOtp2"
                    android:layout_width="0dp"
                    android:layout_height="50dp"
                    android:layout_weight="1"
                    app:cardBackgroundColor="@color/auth_surface"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="0dp"
                    app:strokeColor="@color/auth_surface_stroke"
                    app:strokeWidth="1dp">

                    <TextView
                        android:id="@+id/textOtpDigit2"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:textColor="@color/auth_text_primary"
                        android:textSize="23sp"
                        android:textStyle="bold"
                        tools:text="2" />
                </com.google.android.material.card.MaterialCardView>

                <Space
                    android:layout_width="8dp"
                    android:layout_height="1dp" />

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardOtp3"
                    android:layout_width="0dp"
                    android:layout_height="50dp"
                    android:layout_weight="1"
                    app:cardBackgroundColor="@color/auth_surface"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="0dp"
                    app:strokeColor="@color/auth_surface_stroke"
                    app:strokeWidth="1dp">

                    <TextView
                        android:id="@+id/textOtpDigit3"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:textColor="@color/auth_text_primary"
                        android:textSize="23sp"
                        android:textStyle="bold"
                        tools:text="3" />
                </com.google.android.material.card.MaterialCardView>

                <Space
                    android:layout_width="8dp"
                    android:layout_height="1dp" />

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardOtp4"
                    android:layout_width="0dp"
                    android:layout_height="50dp"
                    android:layout_weight="1"
                    app:cardBackgroundColor="@color/auth_surface"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="0dp"
                    app:strokeColor="@color/auth_surface_stroke"
                    app:strokeWidth="1dp">

                    <TextView
                        android:id="@+id/textOtpDigit4"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:textColor="@color/auth_text_primary"
                        android:textSize="23sp"
                        android:textStyle="bold"
                        tools:text="4" />
                </com.google.android.material.card.MaterialCardView>

                <Space
                    android:layout_width="8dp"
                    android:layout_height="1dp" />

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardOtp5"
                    android:layout_width="0dp"
                    android:layout_height="50dp"
                    android:layout_weight="1"
                    app:cardBackgroundColor="@color/auth_surface"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="0dp"
                    app:strokeColor="@color/auth_surface_stroke"
                    app:strokeWidth="1dp">

                    <TextView
                        android:id="@+id/textOtpDigit5"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:textColor="@color/auth_text_primary"
                        android:textSize="23sp"
                        android:textStyle="bold"
                        tools:text="5" />
                </com.google.android.material.card.MaterialCardView>

                <Space
                    android:layout_width="8dp"
                    android:layout_height="1dp" />

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardOtp6"
                    android:layout_width="0dp"
                    android:layout_height="50dp"
                    android:layout_weight="1"
                    app:cardBackgroundColor="@color/auth_surface"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="0dp"
                    app:strokeColor="@color/auth_surface_stroke"
                    app:strokeWidth="1dp">

                    <TextView
                        android:id="@+id/textOtpDigit6"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:textColor="@color/auth_text_primary"
                        android:textSize="23sp"
                        android:textStyle="bold"
                        tools:text="6" />
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <androidx.appcompat.widget.AppCompatEditText
                android:id="@+id/editOtp"
                android:layout_width="1dp"
                android:layout_height="1dp"
                android:layout_marginTop="2dp"
                android:alpha="0.02"
                android:background="@null"
                android:digits="0123456789"
                android:imeOptions="actionDone"
                android:inputType="number"
                android:maxLength="6"
                android:textColor="@android:color/transparent"
                android:textCursorDrawable="@null"
                tools:text="123456" />

            <LinearLayout
                android:id="@+id/rowAutoFetch"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/textAutoFetch"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/otp_auto_fetching"
                    android:textColor="@color/auth_text_hint"
                    android:textSize="13sp" />

                <ImageView
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:layout_marginStart="4dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_chevron_down_16"
                    android:tint="@color/auth_text_hint" />
            </LinearLayout>

            <TextView
                android:id="@+id/textOtpLabel"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:text="@string/otp_enter_label"
                android:visibility="gone" />

            <TextView
                android:id="@+id/buttonResendOtp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:text="@string/otp_retry_placeholder"
                android:textColor="@color/auth_text_primary"
                android:textSize="15sp"
                android:textStyle="bold"
                tools:text="Retry in 00:30" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <LinearLayout
        android:id="@+id/bottomContent"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="12dp"
        android:paddingEnd="20dp"
        android:paddingBottom="24dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonVerifyOtp"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="@string/otp_verify"
                android:textAllCaps="false"
                android:textColor="@color/auth_button_text"
                android:textSize="17sp"
                android:textStyle="bold"
                app:backgroundTint="@color/auth_button_background"
                app:cornerRadius="18dp" />

            <ProgressBar
                android:id="@+id/progressVerifyOtp"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center_vertical|end"
                android:layout_marginEnd="18dp"
                android:indeterminateTint="@color/auth_button_text"
                android:visibility="gone" />
        </FrameLayout>
    </LinearLayout>

    <androidx.compose.ui.platform.ComposeView
        android:id="@+id/offlineOverlay"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:elevation="20dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
